# 先忽略全部
*
# 但保留 .gitignore 自身（否则下一行也会被忽略）
!.gitignore
!/scripts/
!/scripts/**
!/Plugins/
!/Plugins/**
!/pipeline_automation/
!/pipeline_automation/**
!README.md
scripts/trajectory_figs

# Python runtime caches are generated locally.
**/__pycache__/
*.py[cod]

!/FOREST_DATASET.md
!/.gitattributes
!/Config/
!/Config/Dataset/
!/Config/Dataset/**
