# This repository contains code, plugin assets and dataset recipes.
# Project Content/ assets and render outputs are deployed separately.
*
!/.gitignore
!/.gitattributes
!/README.md
!/FOREST_DATASET.md
!/pytest.ini
!/requirements-dev.txt
!/PCGBiomeForestPoplar.uproject
!/Source/
!/Source/**
!/Config/
!/Config/DefaultEngine.ini
!/Config/Dataset/
!/Config/Dataset/**
!/Plugins/
!/Plugins/MatrixCityPlugin/
!/Plugins/MatrixCityPlugin/**
!/scripts/
!/scripts/**
!/docs/
!/docs/**
!/tests/
!/tests/**

# Generated files must stay local, including inside otherwise allowed trees.
**/Binaries/
**/Intermediate/
**/Saved/
**/DerivedDataCache/
**/__pycache__/
**/.pytest_cache/
**/_build/
*.py[cod]
.DS_Store
/scripts/trajectory_figs/

# Deployment settings and optional notification credentials.
/Plugins/MatrixCityPlugin/misc/user.json
/Plugins/MatrixCityPlugin/misc/user.local*.json
/Plugins/MatrixCityPlugin/misc/email.json
