+// Keep the unused aspect of a combined depth/stencil attachment in an explicitly
+// tracked read-only state. Vulkan render passes otherwise transition that aspect
+// through their attachment initial/final layouts even when its RHI access is Nop.
+// This workaround is deliberately limited to desktop Vulkan SM6, single-sample,
+// persistent attachments without a resolve target.
+FDepthStencilBinding GetVulkanTrackedDepthStencilBinding(FDepthStencilBinding Binding)
+{
+	FRDGTextureRef Texture = Binding.GetTexture();
+	if (RHIGetInterfaceType() != ERHIInterfaceType::Vulkan || GMaxRHIShaderPlatform != SP_VULKAN_SM6 ||
+		!Texture || Texture->Desc.Format != PF_DepthStencil || Texture->Desc.NumSamples != 1 ||
+		EnumHasAnyFlags(Texture->Desc.Flags, TexCreate_Memoryless) || Binding.GetResolveTexture())
+	{
+		return Binding;
+	}
+
+	FExclusiveDepthStencil Access = Binding.GetDepthStencilAccess();
+	if (!Access.IsUsingDepth() && Access.IsUsingStencil())
+	{
+		Binding.SetDepthLoadAction(ERenderTargetLoadAction::ELoad);
+		Access = Access.IsStencilWrite() ? FExclusiveDepthStencil::DepthRead_StencilWrite : FExclusiveDepthStencil::DepthRead_StencilRead;
+	}
+	else if (Access.IsUsingDepth() && !Access.IsUsingStencil())
+	{
+		Binding.SetStencilLoadAction(ERenderTargetLoadAction::ELoad);
+		Access = Access.IsDepthWrite() ? FExclusiveDepthStencil::DepthWrite_StencilRead : FExclusiveDepthStencil::DepthRead_StencilRead;
+	}
+	Binding.SetDepthStencilAccess(Access);
+	return Binding;
+}
